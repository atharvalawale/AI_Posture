# Copy to .env.local for local development. In production, set these in Vercel
# (Project settings > Environment Variables). Never commit real values.

# Resend API key with "Sending access" (or full access, which the newsletter needs
# to add contacts). Without it, /api/contact and /api/newsletter answer 502 and the
# forms tell visitors to email hello@fiixbee.com instead.
RESEND_API_KEY=

# Sender shown on contact form emails. The domain must be verified in Resend.
# Default: FiixBE website <website@fiixbee.com>
RESEND_FROM="FiixBE website <website@fiixbee.com>"

# ID of the Resend segment (formerly "audience") that newsletter sign-ups join.
# Resend > Audience > Segments > open the segment > copy its ID.
RESEND_AUDIENCE_ID=

# Inbox that receives contact form messages. Default: hello@fiixbee.com
CONTACT_TO=hello@fiixbee.com

# Base WebSocket URL of the pose backend used by /session. The page appends
# /{exercise}/{side}?reps_target={n}. Public: it is inlined into the browser bundle
# at build time, so rebuild after changing it. Use ws://localhost:8000/ws/pose for a local backend.
NEXT_PUBLIC_POSE_WS_URL=wss://ai-posture-backend.onrender.com/ws/pose
